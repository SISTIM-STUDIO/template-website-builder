---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Page not found" description="The page you are looking for could not be found.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">404 · Page not found</span>
      <h1>That page isn't here.</h1>
      <p class="hero-copy">The link may be outdated, or the page may have moved.</p>
      <div class="actions">
        <a class="button" href={base}>Return to home</a>
      </div>
    </div>
  </section>
</BaseLayout>

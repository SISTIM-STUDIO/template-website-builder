---
import packages from "../../content/sumbawa-trip-packages.json";
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin SUMBAWA TRIP</title><style>
:root{--ink:#10251d;--deep:#0d1b18;--green:#214b3a;--gold:#d7ae5b;--line:#e1e6e0;--muted:#718078}*{box-sizing:border-box}body{margin:0;background:#f5f7f4;color:var(--ink);font:14px Arial,sans-serif}.app{display:grid;grid-template-columns:230px 1fr;min-height:100vh}.side{background:var(--deep);color:white;padding:24px 16px}.brand{font-weight:900;letter-spacing:2px}.brand small{display:block;font-size:9px;color:#c8d3cc;margin-top:5px}.nav{display:grid;gap:5px;margin-top:32px}.nav button{border:0;background:none;color:#c6d0ca;text-align:left;padding:12px;border-radius:7px;cursor:pointer}.nav button.active{background:var(--green);color:white}.main{min-width:0}.top{background:white;border-bottom:1px solid var(--line);padding:22px 28px;display:flex;justify-content:space-between}.top span,.muted{color:var(--muted);font-size:12px}.content{padding:26px;max-width:1200px;margin:auto}.alert{background:#fff7df;border:1px solid #ead9a6;padding:13px;border-radius:7px;color:#695b36;font-size:12px;line-height:1.6;margin-bottom:22px}.section{display:none}.section.active{display:block}.head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.head h1{margin:0 0 5px;font-size:28px}.head p{margin:0;color:var(--muted);font-size:13px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.card,.panel{background:white;border:1px solid var(--line);border-radius:8px;padding:18px;margin-bottom:16px}.card small{color:var(--muted)}.card strong{display:block;font-size:26px;margin-top:8px}.btn{border:0;background:var(--green);color:white;padding:10px 14px;border-radius:6px;cursor:pointer;font-weight:bold}.btn.gold{background:var(--gold);color:var(--ink)}.btn.light{background:#edf2ed;color:var(--ink)}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:11px;border-bottom:1px solid var(--line);font-size:12px}th{color:var(--muted)}.scroll{overflow:auto}.field{display:grid;gap:6px;margin:12px 0}.field label{font-size:12px;font-weight:bold}.field input,.field textarea,.field select{padding:10px;border:1px solid var(--line);border-radius:5px;font:inherit}.field textarea{min-height:75px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.hidden{display:none!important}.actions button{margin-right:5px;border:0;padding:7px;border-radius:4px;cursor:pointer}@media(max-width:800px){.app{grid-template-columns:1fr}.side{padding:14px}.nav{display:flex;overflow:auto;margin-top:12px}.nav button{white-space:nowrap}.content{padding:16px}.cards{grid-template-columns:1fr 1fr}.top{padding:15px}.head{align-items:flex-start;gap:10px;flex-direction:column}.grid{grid-template-columns:1fr}}
</style></head><body><div class="app"><aside class="side"><div class="brand">SUMBAWA TRIP<small>ADMIN WORKSPACE</small></div><nav class="nav" id="nav"><button class="active" data-tab="overview">▦ Dashboard</button><button data-tab="packages">◇ Paket Wisata</button><button data-tab="schedule">▣ Jadwal Open Trip</button><button data-tab="bookings">▤ Booking</button><button data-tab="gallery">▧ Foto & Galeri</button><button data-tab="articles">✎ Artikel</button><button data-tab="stats">▥ Statistik</button><button data-tab="settings">⚙ Pengaturan</button></nav></aside><div class="main"><header class="top"><b id="title">Dashboard</b><span>SUMBAWA TRIP · Admin</span></header><main class="content">
<div class="alert"><b>Mode preview — belum terhubung ke database.</b> Perubahan disimpan di browser/perangkat ini saja, belum tersinkron ke website publik. Login admin dan penyimpanan online wajib diaktifkan sebelum peluncuran.</div>
<section id="overview" class="section active"><div class="head"><div><h1>Selamat datang</h1><p>Ringkasan pengelolaan website SUMBAWA TRIP.</p></div><a class="btn gold" href="/sumbawa-trip/" target="_blank">Lihat Website ↗</a></div><div class="cards"><div class="card"><small>Paket wisata</small><strong id="cp">5</strong></div><div class="card"><small>Jadwal open trip</small><strong id="cs">0</strong></div><div class="card"><small>Permintaan booking</small><strong>WhatsApp</strong></div><div class="card"><small>Artikel</small><strong id="ca">0</strong></div></div></section>
<section id="packages" class="section"><div class="head"><div><h1>Paket Wisata</h1><p>Tambah, edit, dan ekspor katalog paket.</p></div><button class="btn" id="add">+ Tambah Paket</button></div><div class="panel scroll"><table><thead><tr><th>Nama paket</th><th>Durasi</th><th>Kategori</th><th>Harga</th><th>Aksi</th></tr></thead><tbody id="rows"></tbody></table></div><div class="panel hidden" id="editor"><h3 id="et">Tambah paket</h3><div class="grid"><div class="field"><label>Nama</label><input id="pt"></div><div class="field"><label>Durasi</label><input id="pd"></div><div class="field"><label>Kategori</label><input id="pc"></div><div class="field"><label>Harga</label><input id="pp"></div></div><div class="field"><label>Deskripsi</label><textarea id="ps"></textarea></div><button class="btn" id="save">Simpan</button> <button class="btn light" id="cancel">Batal</button></div><div class="panel"><button class="btn light" id="export">Unduh packages.json</button><p class="muted">Ekspor ini belum mengubah data website publik. Sinkronisasi akan diaktifkan setelah CMS backend terhubung.</p></div></section>
<section id="schedule" class="section"><div class="head"><div><h1>Jadwal Open Trip</h1><p>Rencana keberangkatan dan kuota.</p></div></div><div class="panel"><div class="grid"><div class="field"><label>Nama perjalanan</label><input id="sn"></div><div class="field"><label>Tanggal</label><input id="sd" type="date"></div><div class="field"><label>Kuota</label><input id="sq" type="number"></div><div class="field"><label>Status</label><select id="ss"><option>Dibuka</option><option>Segera dibuka</option><option>Penuh</option><option>Dibatalkan</option></select></div></div><button class="btn" id="sadd">Simpan jadwal</button></div><div class="panel scroll"><table><thead><tr><th>Perjalanan</th><th>Tanggal</th><th>Kuota</th><th>Status</th></tr></thead><tbody id="srows"></tbody></table></div></section>
<section id="bookings" class="section"><div class="head"><div><h1>Booking</h1><p>Permintaan saat ini diteruskan ke WhatsApp admin.</p></div></div><div class="panel"><p class="muted">Belum ada database booking. Tahap produksi akan mencakup penyimpanan permintaan, status follow-up, DP minimal 50%, pelunasan H-3, dan konfirmasi admin.</p></div></section>
<section id="gallery" class="section"><div class="head"><div><h1>Foto & Galeri</h1><p>Manajemen foto dan materi visual.</p></div></div><div class="panel"><p class="muted">Modul produksi: unggah foto, kategori destinasi, alt text SEO, foto hero, dan urutan galeri. Aset asli V5 perlu dipasang sebelum galeri diaktifkan.</p></div></section>
<section id="articles" class="section"><div class="head"><div><h1>Artikel</h1><p>Draft artikel dan SEO destinasi.</p></div></div><div class="panel"><div class="field"><label>Judul artikel</label><input id="at"></div><div class="field"><label>Slug</label><input id="as"></div><div class="field"><label>Ringkasan</label><textarea id="ar"></textarea></div><button class="btn" id="asave">Simpan draft lokal</button></div><div class="panel scroll"><table><tbody id="arows"></tbody></table></div></section>
<section id="stats" class="section"><div class="head"><div><h1>Statistik</h1><p>Performa website.</p></div></div><div class="panel"><p class="muted">Analitik kunjungan, klik WhatsApp, konversi booking, dan artikel membutuhkan integrasi analytics.</p></div></section>
<section id="settings" class="section"><div class="head"><div><h1>Pengaturan</h1><p>Identitas dan kontak brand.</p></div></div><div class="panel"><p><b>SUMBAWA TRIP</b><br>YOUR GATEWAY TO SUMBAWA ADVENTURE<br>WhatsApp: 6281246203185</p><p class="muted">Login admin, peran pengguna, dan konfigurasi akan disiapkan setelah backend dipilih.</p></div></section>
</main></div></div><script type="application/json" id="seed" set:html={JSON.stringify(packages)}></script><script>
const $=id=>document.getElementById(id),get=(k,d)=>{try{return JSON.parse(localStorage.getItem("st-"+k))??d}catch{return d}},put=(k,v)=>localStorage.setItem("st-"+k,JSON.stringify(v));let p=get("packages",JSON.parse($("seed").textContent)),s=get("schedule",[]),a=get("articles",[]),edit=-1;const labels={overview:"Dashboard",packages:"Paket Wisata",schedule:"Jadwal Open Trip",bookings:"Booking",gallery:"Foto & Galeri",articles:"Artikel",stats:"Statistik",settings:"Pengaturan"};function esc(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}function render(){$("cp").textContent=p.length;$("cs").textContent=s.length;$("ca").textContent=a.length;$("rows").innerHTML=p.map((x,i)=>'<tr><td>'+esc(x.title)+'</td><td>'+esc(x.duration)+'</td><td>'+esc(x.category)+'</td><td>'+esc(x.price)+'</td><td class="actions"><button data-e="'+i+'">Edit</button><button data-d="'+i+'">Hapus</button></td></tr>').join("");$("srows").innerHTML=s.map(x=>'<tr><td>'+esc(x.name)+'</td><td>'+esc(x.date)+'</td><td>'+esc(x.quota)+'</td><td>'+esc(x.status)+'</td></tr>').join("");$("arows").innerHTML=a.map(x=>'<tr><td>'+esc(x.title)+'</td><td>'+esc(x.slug)+'</td></tr>').join("")}function tab(id){document.querySelectorAll(".section").forEach(x=>x.classList.toggle("active",x.id===id));document.querySelectorAll("[data-tab]").forEach(x=>x.classList.toggle("active",x.dataset.tab===id));$("title").textContent=labels[id]}$("nav").onclick=e=>{let b=e.target.closest("[data-tab]");if(b)tab(b.dataset.tab)};function editor(x={}){$("editor").classList.remove("hidden");$("et").textContent=edit<0?"Tambah paket":"Edit paket";$("pt").value=x.title||"";$("pd").value=x.duration||"";$("pc").value=x.category||"";$("pp").value=x.price||"Minta penawaran";$("ps").value=x.short||""}$("add").onclick=()=>{edit=-1;editor()};$("cancel").onclick=()=>$("editor").classList.add("hidden");$("rows").onclick=e=>{let b=e.target.closest("button");if(!b)return;let i=Number(b.dataset.e??b.dataset.d);if(b.dataset.e!==undefined){edit=i;editor(p[i])}else if(b.dataset.d!==undefined&&confirm("Hapus paket lokal?")){p.splice(i,1);put("packages",p);render()}};$("save").onclick=()=>{let x={id:edit<0?"custom-"+Date.now():p[edit].id,title:$("pt").value.trim(),duration:$("pd").value.trim(),category:$("pc").value.trim(),price:$("pp").value.trim(),short:$("ps").value.trim()};if(!x.title)return alert("Nama paket wajib diisi");if(edit<0)p.push(x);else p[edit]=x;put("packages",p);$("editor").classList.add("hidden");render()};$("export").onclick=()=>{let u=URL.createObjectURL(new Blob([JSON.stringify(p,null,2)],{type:"application/json"})),l=document.createElement("a");l.href=u;l.download="sumbawa-trip-packages.json";l.click();URL.revokeObjectURL(u)};$("sadd").onclick=()=>{if(!$("sn").value||!$("sd").value)return alert("Nama dan tanggal wajib diisi");s.push({name:$("sn").value,date:$("sd").value,quota:$("sq").value,status:$("ss").value});put("schedule",s);render()};$("asave").onclick=()=>{if(!$("at").value||!$("as").value)return alert("Judul dan slug wajib diisi");a.push({title:$("at").value,slug:$("as").value,summary:$("ar").value});put("articles",a);$("at").value=$("as").value=$("ar").value="";render()};render();
</script></body></html>
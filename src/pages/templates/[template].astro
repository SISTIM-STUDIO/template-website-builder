---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { templateOptions } from "../../content/site";
import { templateDetails } from "../../content/template-details";

export function getStaticPaths() {
  return templateOptions.map((template) => ({
    params: { template: template.slug },
    props: { template },
  }));
}

const { template } = Astro.props;
const details = templateDetails[template.slug as keyof typeof templateDetails];
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={template.name} description={template.description}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{template.eyebrow}</span>
      <h1>{template.name}</h1>
      <p class="hero-copy">{details.intro}</p>
      <div class="actions">
        <a class="button" href={`${base}about/`}>{details.action}</a>
        <a class="button secondary" href={base}>Back to overview</a>
      </div>
      <p>{details.actionNote}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">{details.subtitle}</span>
          <h2>A useful starting structure</h2>
        </div>
      </div>
      <div class="template-grid">
        {details.sections.map((section, index) => (
          <article class="template-card">
            <span class="number">0{index + 1}</span>
            <h3>{section.title}</h3>
            <p>{section.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
